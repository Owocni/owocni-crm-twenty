# Skopiuj jako .env.deploy (NIE commituj).
GCP_PROJECT=owocni-robot
GCP_REGION=europe-central2
FUNCTION_NAME=system-health-check

# Snapshot stanu (debounce pagera). Utworzy bucket jeśli brak.
HEALTH_GCS_BUCKET=owocni-system-health

# Odbiorca pagera / digestu (nie jest sekretem)
HEALTH_ALERT_TO=

# SMTP — placeholdery. Prawdziwe wartości TYLKO w lokalnym .env.deploy (gitignored).
HEALTH_SMTP_HOST=smtp.example.com
HEALTH_SMTP_PORT=587
HEALTH_SMTP_USER=reports@example.com
HEALTH_SMTP_PASS=change-me
HEALTH_SMTP_FROM=reports@example.com

# Twenty — sandbox (wymagany). Prod: SKIP jeśli pusty, nie DOWN.
TWENTY_API_KEY_SANDBOX=
TWENTY_REST_URL_SANDBOX=https://api.twenty.com/rest
TWENTY_API_KEY_PROD=
TWENTY_REST_URL_PROD=https://api.twenty.com/rest

# Ten sam klucz sandbox+prod = jedna instancja (dedup, bez podwójnych GET).
# n8n — wymagane dla H-CALL. Brak klucza / nieaktywne = DOWN (nie UNKNOWN).
N8N_BASE_URL=
N8N_API_KEY=

# Okno importu: ISO timestamp do kiedy MUST_ON OFF jest OK
# HEALTH_GATE_UNTIL=2026-08-20T18:00:00+02:00
