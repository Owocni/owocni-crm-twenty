# Skopiuj jako .env.deploy (NIE commituj). Wartości jak w GoogleCloudRobot.
# Project ID w GCP (NIE nazwa usługi Cloud Run!)
# Robot: service=robot-task-monitor, project=owocni-robot
GCP_PROJECT=owocni-robot
GCP_REGION=europe-central2
FUNCTION_NAME=twenty-crm-worker-sandbox

STAPE_API_KEY=
STAPE_API_BASE=https://uinpcbwf.eug.stape.io/stape-api

TWENTY_API_KEY=
TWENTY_REST_URL=https://api.twenty.com/rest
CREATE_LEAD_WRITE_ENABLED=true

# Continuity (Account Owner) — default OFF until T4 smoke PASS
CONTINUITY_ROUTING_ENABLED=false
