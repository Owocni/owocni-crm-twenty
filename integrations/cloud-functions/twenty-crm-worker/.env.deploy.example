# Skopiuj jako .env.deploy (NIE commituj). Wartości jak w GoogleCloudRobot.
# Project ID w GCP (NIE nazwa usługi Cloud Run!)
# Robot: service=robot-task-monitor, project=owocni-robot
GCP_PROJECT=owocni-robot
GCP_REGION=europe-central2
FUNCTION_NAME=twenty-crm-worker-sandbox

STAPE_API_KEY=
STAPE_API_BASE=https://uinpcbwf.eug.stape.io/stape-api

TWENTY_API_KEY=
TWENTY_REST_URL=https://api.twenty.com/rest
CREATE_LEAD_WRITE_ENABLED=true

# Continuity (Account Owner) — default OFF until T4 smoke PASS
CONTINUITY_ROUTING_ENABLED=false
# CONTINUITY_OWNER_IDS=4704e0c0-...,ccac533d-...,7fddba1d-...,23ac9976-...  # bez Ewy

TWENTY_OWNER_MACIEJ=7fddba1d-e443-47d4-97b7-a3a829efd8c1
TWENTY_OWNER_MARTA=4704e0c0-8d77-4640-ad1e-1875294294df
TWENTY_OWNER_GOSIA=ccac533d-a34b-4cfc-a036-9e75ee3f8910
TWENTY_OWNER_EWA=b9e2b31e-0b4a-4936-9d2a-2e5b4a3e0b16
TWENTY_OWNER_ROBERT=23ac9976-0232-4097-b056-5dc391bf7c34

# Numery Play PBX → owner (domyślnie w kodzie: Marta, Gosia, Ewa, Maciej, Robert)
# PHONE_OWNER_MAP=48660970980:<marta>,48570704470:<gosia>,48733337712:<ewa>,48535009444:<maciej>,48575970640:<robert>
# CALL_TRANSCRIPT_PARKING_TASKS=false

# ENRICH Company PL (przycisk GUS/KRS) — low-privilege token for workflow HTTP
ENRICH_COMPANY_PL_TOKEN=
# GUS_BIR_KEY=   # produkcyjny klucz BIR; bez niego worker używa MF+KRS

# Fakturownia (issue invoice)
X_INVOICE_TOKEN=
FAKTUROWNIA_DOMAIN=owocni.fakturownia.pl
FAKTUROWNIA_API_TOKEN=
FAKTUROWNIA_DEPARTMENT_ID=
